<?xml version="1.0"?>
<package format="3">
  <name>axis_web_bridge</name>
  <version>0.1.0</version>
  <description>ROS 2 AXIS camera topics to MJPEG and WebSocket bridge.</description>
  <maintainer email="coastalpatrol@example.com">CoastalPatrol Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>axis_camera_msgs</exec_depend>
  <exec_depend>python3-aiohttp</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
